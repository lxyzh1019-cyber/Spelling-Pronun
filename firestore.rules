rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users document — only accessible by the user themselves
    match /spelling-users/{userId} {
      allow read, write: if request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Progress documents — per-user and per-profile isolation
    // Document ID format: {userId}_{profileId}_{wordId}
    match /spelling-progress/{document=**} {
      allow read: if
        request.auth.uid != null &&
        request.auth.uid == resource.data.userId;

      allow create: if
        request.auth.uid != null &&
        request.auth.uid == request.resource.data.userId;

      allow update: if
        request.auth.uid != null &&
        request.auth.uid == resource.data.userId &&
        request.auth.uid == request.resource.data.userId;

      allow delete: if
        request.auth.uid != null &&
        request.auth.uid == resource.data.userId;
    }

    // Immutable attempt events preserve evidence type and learner attribution.
    match /spelling-attempts/{document} {
      allow get: if request.auth.uid != null && document.matches(request.auth.uid + '_.*');
      allow list: if request.auth.uid != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid != null &&
        request.auth.uid == request.resource.data.userId &&
        document.matches(request.auth.uid + '_.*');
      allow update, delete: if false;
    }

    // Resumable sessions use monotonic revisions. A second authenticated device
    // may explicitly take ownership by increasing ownerEpoch; stale devices can
    // neither rewind state nor change the pinned content identity.
    match /spelling-sessions/{document} {
      allow get: if request.auth.uid != null && document.matches(request.auth.uid + '__.*');
      allow list: if request.auth.uid != null && request.auth.uid == resource.data.userId;
      allow create: if request.auth.uid != null &&
        request.auth.uid == request.resource.data.userId &&
        document.matches(request.auth.uid + '__.*') &&
        request.resource.data.revision == 1 &&
        request.resource.data.ownerEpoch == 1;
      allow update: if request.auth.uid != null &&
        request.auth.uid == resource.data.userId &&
        request.auth.uid == request.resource.data.userId &&
        request.resource.data.learnerId == resource.data.learnerId &&
        request.resource.data.sessionId == resource.data.sessionId &&
        request.resource.data.mode == resource.data.mode &&
        request.resource.data.contentVersion == resource.data.contentVersion &&
        request.resource.data.orderedItemIds == resource.data.orderedItemIds &&
        request.resource.data.revision == resource.data.revision + 1 &&
        ((request.resource.data.deviceId == resource.data.deviceId &&
          request.resource.data.ownerEpoch == resource.data.ownerEpoch) ||
         (request.resource.data.deviceId != resource.data.deviceId &&
          request.resource.data.ownerEpoch == resource.data.ownerEpoch + 1));
      allow delete: if false;
    }

    // Achievements — per-user/profile
    match /spelling-achievements/{document} {
      allow read, write: if
        request.auth.uid != null &&
        document.matches(request.auth.uid + '_.*');
    }

    // Hints tracker — per-user/profile
    match /spelling-hints/{document} {
      allow read, write: if
        request.auth.uid != null &&
        document.matches(request.auth.uid + '_.*');
    }

    // Daily challenge — per-user/profile
    match /spelling-daily-challenges/{document} {
      allow read, write: if
        request.auth.uid != null &&
        document.matches(request.auth.uid + '_.*');
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
